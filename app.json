{
  "expo": {
    "name": "FoodGo",
    "slug": "foodgo",
    "scheme": "foodgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/foodgo-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EA1D2C",
        "foregroundImage": "./assets/foodgo-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/foodgo-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
